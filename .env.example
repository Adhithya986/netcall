# ==============================================================================
# NETCALL PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables for your local or production environment.
# NEVER commit real credentials, secrets, or keys to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
# For local development with external MongoDB or MongoDB Atlas:
MONGODB_URI=mongodb://localhost:27017/netcall
# Set to 'true' if running locally without external MongoDB to use in-memory database
USE_IN_MEMORY_DB=true

# Security & JWT Secrets
JWT_ACCESS_SECRET=netcall_access_token_dev_secret_replace_in_production_32chars!
JWT_REFRESH_SECRET=netcall_refresh_token_dev_secret_replace_in_production_32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# WebRTC STUN / TURN Server Configuration
# Multiple STUN servers separated by comma
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server credentials
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Telephony Provider (PSTN Integration Layer)
# Supported options: MOCK, AIRTEL_IQ, EXOTEL, TATA_TELE, TWILIO
TELEPHONY_PROVIDER=MOCK
TELEPHONY_WEBHOOK_SECRET=mock_webhook_secret_for_local_development

# Indian Telecom Sandbox Mode (Keep 'true' unless official DoT license & provider credentials are provided)
TELEPHONY_SANDBOX_MODE=true

# Optional Real Telecom Provider Credentials (Only when approved by DoT & provider)
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SUBDOMAIN=
# AIRTEL_IQ_APP_ID=
# AIRTEL_IQ_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Pricing & Billing Configuration (in Integer Paise: 100 paise = 1 INR)
INITIAL_USER_WALLET_PAISE=50000
PSTN_CALL_RATE_PAISE_PER_MIN=150
INTERNET_CALL_RATE_PAISE_PER_MIN=0

# Frontend Environment Variables (apps/web)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
